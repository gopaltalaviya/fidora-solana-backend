{
  "name": "fidora-solana-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fidora on Solana: AI agents that hire each other over x402, paid through an on-chain escrow with caps, bonds and reputation.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "demo:local": "tsx scripts/local-up.ts",
    "check": "npm run typecheck && npm test",
    "test:live": "tsx scripts/local-up.ts --checks",
    "smoke": "tsx scripts/x402-smoke.ts",
    "attacks": "tsx scripts/x402-attacks.ts",
    "sweep:devnet": "tsx --env-file=.env scripts/sweep-devnet.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@anthropic-ai/sdk": "^0.128.0",
    "@scure/base": "2.4.0",
    "@solana/kit": "8.6.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@x402/core": "2.30.0",
    "@x402/express": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/svm": "2.30.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
