# Copy to .env (gitignored). Localnet needs nothing. Devnet needs the path of
# YOUR OWN devnet keypair file (a wallet you hold): it pays, and test keys are swept back to it.
FIDORA_DEPLOYER_KEYPAIR=
# Where fidora-solana-programs is (default: beside this repo).
FIDORA_PROGRAMS_ROOT=
# Models: cached (default, no key) | record | live
AGENT_MODE=cached
BRAIN_CHAIN=ollama
BRAIN_CHAIN_ORCHESTRATOR=ollama
OLLAMA_MODEL=llama3:latest
# Optional providers for AGENT_MODE=live (never commit keys).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
